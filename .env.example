# Set actual values in Railway variables, not in this file.
APP_ENV=production
APP_URL=https://your-domain.example/autotrackplus
DB_HOST=your-private-mysql-host
DB_PORT=3306
DB_NAME=your-database
DB_USER=your-application-user
DB_PASSWORD=
# Optional: path to a CA certificate when your MySQL service requires verified TLS.
DB_SSL_CA=
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_TLS=1
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=accounts@example.com
